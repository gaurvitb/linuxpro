# Git line-ending normalisation for LINUXPULSE
# Ensures shell scripts always use LF on disk regardless of host OS

* text=auto

# Shell scripts — always LF
*.sh    text eol=lf
*.bash  text eol=lf

# Windows batch / PowerShell — CRLF is acceptable, but normalise on checkout
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Source code — LF
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.conf  text eol=lf
*.txt   text eol=lf

# Binary assets — do not touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary

